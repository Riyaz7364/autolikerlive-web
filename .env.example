APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Facebook OAuth Configuration
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://www.autolikerlive.com/app/rajeliker/callback

# Google Search Console daily blog keyword research
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DAILY_BLOG_GSC_ENABLED=false
DAILY_BLOG_GSC_SITE_URL=sc-domain:autolikerlive.com
DAILY_BLOG_GSC_LOOKBACK_DAYS=90
DAILY_BLOG_GSC_RECENT_DAYS=14
DAILY_BLOG_GSC_DATA_LAG_DAYS=3
DAILY_BLOG_GSC_MIN_IMPRESSIONS=20
DAILY_BLOG_GSC_MAX_POSITION=35

ADMIN_SECRET_KEY=change-me

# AI Credits API (aicredits.in) - Used for game AI predictions
AICREDIT_API_KEY=your_aicredit_api_key_here
AICREDIT_BASE_URL=https://api.aicredits.in/v1
AICREDIT_TEXT_MODEL=deepseek/deepseek-v4-pro

# Live chat (guest->admin widget + guest APIs)
CHAT_ENABLED=false

# Google AdSense (library + units site-wide)
ADSENSE_ENABLED=true

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Temp Mail API
TEMPMAIL_TTL_MINUTES=120
TEMPMAIL_MAX_TTL_MINUTES=1440
TEMPMAIL_RATE_LIMIT=60
TEMPMAIL_WATCH_WINDOW_MINUTES=30
TEMPMAIL_ALLOW_UNOWNED_ACCESS=false
TEMPMAIL_LOG_RESPONSES=false

# Firebase App Check
FIREBASE_APPCHECK_ENFORCE=true
FIREBASE_APPCHECK_LOG_ACCEPTED=false
FIREBASE_PROJECT_ID=temp-mail-e39fe
FIREBASE_PROJECT_NUMBER=610463736485
# Comma-separated list: production (Play Store) + debug app IDs.
FIREBASE_APP_IDS=1:610463736485:android:44746b7286ac396716634c,1:610463736485:android:747df09ec27a30e116634c
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
